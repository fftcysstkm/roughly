{
  "expo": {
    "name": "Roughly",
    "slug": "roughly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-calendar.png",
    "scheme": "roughly",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/app-icon-calendar.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tkmst.roughly"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
